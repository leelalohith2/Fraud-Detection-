# === AI Fraud Intelligence Command Center — Environment Configuration ===

# Database (SQLite by default so the project runs with zero setup.
# Point this at a real Postgres DSN in production, e.g.
# postgresql+psycopg2://user:password@localhost:5432/fraud_db)
DATABASE_URL=sqlite:///./datasets/fraud_command_center.db

# Kafka (optional — the platform falls back to an in-process simulated
# stream automatically if no broker is reachable)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=transactions

# GenAI Copilot (optional — the platform falls back to a built-in
# template/rules-based copilot if no key is supplied)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Alerting (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Risk thresholds
HIGH_RISK_THRESHOLD=0.75
FRAUD_THRESHOLD=0.90
MEDIUM_RISK_THRESHOLD=0.45
